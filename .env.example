# ==========================================
# DocuMind AI - Environment Configuration
# ==========================================

# LLM Provider Configuration: "groq", "openai", "gemini", "ollama", "mock"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_api_key_here
LLM_TEMPERATURE=0.1
# LLM_BASE_URL=http://localhost:11434  # For Ollama / Local OpenAI endpoints

# Embedding Engine Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# RAG & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.35
ENABLE_RERANKING=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage Directories
CHROMA_PERSIST_DIRECTORY=./data/vector_store
UPLOAD_DIRECTORY=./data/uploads
SAMPLE_DOCS_DIRECTORY=./data/sample_docs

# System Limits
MAX_DOCUMENTS_PER_SESSION=50
MAX_FILE_SIZE_MB=50

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
